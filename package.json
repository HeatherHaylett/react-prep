{
  "name": "react-prep",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "web": "yarn workspace @react-prep/web dev",
    "mobile": "yarn workspace @react-prep/mobile start",
    "typecheck": "yarn workspaces run typecheck",
    "lint": "eslint .",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.21.0"
  },
  "version": "1.0.0",
  "dependencies": {
    "expo": "~54.0.33",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
